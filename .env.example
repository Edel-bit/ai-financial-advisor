# Copy this file to .env and fill in. NEVER commit .env to git.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# CLAUDE_MODEL=claude-sonnet-5-5
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Required only for AWS deployment
# S3_BUCKET=your-bucket-name
# S3_PREFIX=ai-financial-advisor
# AWS_DEFAULT_REGION=us-east-2

# Set when the app is public so strangers can't add documents
# ADMIN_PASSWORD=pick-something-long
